HOMEBREW_SYSTEM_ENV_TAKES_PRIORITY=1
HOMEBREW_UPDATE_TO_TAG=1
HOMEBREW_VERIFY_ATTESTATIONS=1
HOMEBREW_NO_INSECURE_REDIRECT=1
HOMEBREW_FORBID_PACKAGES_FROM_PATHS=1
HOMEBREW_NO_ANALYTICS=1
HOMEBREW_ALLOWED_TAPS=homebrew/core homebrew/cask homebrew/autoupdate buildpacks/tap forwardimpact/tap microsoft/apm oven-sh/bun supabase/tap
HOMEBREW_CASK_OPTS=--require-sha
HOMEBREW_FORMULA_BUILD_NETWORK=deny
HOMEBREW_FORMULA_POSTINSTALL_NETWORK=deny
HOMEBREW_FORMULA_TEST_NETWORK=deny
