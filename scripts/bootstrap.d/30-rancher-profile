#!/bin/sh
# Enforce Rancher Desktop's in-app updater through the locked deployment
# profile (auto_updates casks self-update; see README.md Security).
# The profile needs a top-level `version` matching the settings schema, or
# Rancher Desktop rejects the whole file at launch.
set -eu

src="$HOME/scripts/rancher-profile.plist"
domain=io.rancherdesktop.profile.locked

command -v defaults >/dev/null 2>&1 || {
	echo "30-rancher-profile: no defaults(1); not macOS?" >&2
	exit 2
}
[ -f "$src" ] || {
	echo "30-rancher-profile: missing $src" >&2
	exit 1
}

want_version=$(/usr/libexec/PlistBuddy -c 'Print :version' "$src" 2>/dev/null || echo '')
[ -n "$want_version" ] || {
	echo "30-rancher-profile: $src has no top-level version key" >&2
	exit 1
}

have_version=$(defaults read "$domain" version 2>/dev/null || echo '')
if [ "$have_version" = "$want_version" ] &&
	defaults read "$domain" application 2>/dev/null | grep -q 'enabled = 1'; then
	echo "30-rancher-profile: locked profile already enforces the updater"
	exit 0
fi

defaults import "$domain" "$src"
echo "30-rancher-profile: imported $src into $domain"
