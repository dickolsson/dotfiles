#!/bin/sh
# Install and start the daily Homebrew autoupdate launchd job
# (brew update / upgrade / cleanup; auto_updates casks self-update).
set -eu

command -v brew >/dev/null 2>&1 || {
	echo "40-brew-autoupdate: brew is not installed" >&2
	exit 2
}

if brew autoupdate status 2>/dev/null | grep -q 'installed and running'; then
	echo "40-brew-autoupdate: already installed and running"
	exit 0
fi

brew tap | grep -qx homebrew/autoupdate || brew tap homebrew/autoupdate

# A stale or stopped install can make `start` refuse; reset and retry.
if ! brew autoupdate start --upgrade --cleanup; then
	brew autoupdate delete >/dev/null 2>&1 || true
	brew autoupdate start --upgrade --cleanup
fi
echo "40-brew-autoupdate: started (daily, upgrade + cleanup)"
